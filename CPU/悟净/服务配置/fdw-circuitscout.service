[Unit]
Description=CircuitScout 悟净局域网界面
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/fdw_circuitscout/current/app
EnvironmentFile=/root/fdw_circuitscout/service.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/fdw_circuitscout/current/venv/bin/python -m gunicorn --workers 1 --threads 8 --bind 0.0.0.0:8001 --timeout 120 --access-logfile - --error-logfile - interface:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
